{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qt-modes",
  "version": "0.1.0",
  "identifier": "dev.example.qtmodes",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true,
      "pattern": {
        "use": "isolation",
        "options": {
          "dir": "./isolation"
        }
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
